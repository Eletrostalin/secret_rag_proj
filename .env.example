# PostgreSQL config
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Ngrok config
NGROK_AUTHTOKEN=your_ngrok_authtoken

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Models used for different stages
OPENAI_MODEL_ANSWER=gpt-4.1
OPENAI_MODEL_CLASSIFY=gpt-4o-mini
OPENAI_MODEL_REWRITE=gpt-4o
OPENAI_MODEL_EXPAND=gpt-4o
OPENAI_MODEL_FILTER=gpt-4.1
OPENAI_MODEL_RERANK=gpt-4.1